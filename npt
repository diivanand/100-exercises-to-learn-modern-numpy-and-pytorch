#!/usr/bin/env bash
#
# npt -- the workflow driver for this course.
#
#   ./npt next                 run the first exercise that is not yet passing;
#                              this is the main loop
#   ./npt test <filter>        run one exercise    (./npt test 04_02, or solve)
#   ./npt verify               run every exercise (what CI does)
#   ./npt solution <filter>    diff your work against the reference solution
#   ./npt list [filter]        list the exercises and where you are
#   ./npt format [--check]     ruff format over the tree
#   ./npt lint                 ruff check over the tree
#   ./npt clean                remove caches and the progress file
#
# A "filter" is any substring of an exercise id, so `04`, `04_02`, `solve` and
# `02_solve_not_inv` all select 04.02.
#
# Everything runs through `uv run`, so the first command creates the virtual
# environment and installs numpy, torch and pytest. Nothing else is needed.

set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROGRESS_FILE="${ROOT}/.npt-progress"

if [[ -t 1 ]]; then
  readonly BOLD=$'\033[1m' DIM=$'\033[2m' RED=$'\033[31m' GREEN=$'\033[32m'
  readonly YELLOW=$'\033[33m' BLUE=$'\033[34m' RESET=$'\033[0m'
else
  readonly BOLD='' DIM='' RED='' GREEN='' YELLOW='' BLUE='' RESET=''
fi

die() {
  printf '%snpt: %s%s\n' "${RED}" "$*" "${RESET}" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is not on your PATH. $2"
}

# pytest, inside the project's virtual environment. `uv run` creates and syncs
# the environment on first use, so there is no separate install step.
pytest_() {
  (cd "${ROOT}" && uv run --quiet pytest "$@")
}

# --- exercise inventory ------------------------------------------------------

# Prints "<id>\t<directory>" for every exercise, in course order.
#   id        = 04_02_solve_not_inv   (chapter number, exercise number, name)
#   directory = exercises/04_linear_algebra_and_random/02_solve_not_inv
all_exercises() {
  local dir chapter name chapter_number
  while IFS= read -r dir; do
    chapter="$(basename "$(dirname "${dir}")")"
    name="$(basename "${dir}")"
    chapter_number="${chapter%%_*}"
    printf '%s\t%s\n' "${chapter_number}_${name}" "${dir}"
  done < <(find "${ROOT}/exercises" -mindepth 2 -maxdepth 2 -type d | sort)
}

resolve_one() {
  local filter="$1" matches
  matches="$(all_exercises | grep -- "${filter}" || true)"
  [[ -n "${matches}" ]] || die "no exercise matches '${filter}'. Try ./npt list"
  if [[ "$(wc -l <<<"${matches}")" -gt 1 ]]; then
    printf '%snpt: '\''%s'\'' matches several exercises:%s\n' \
      "${YELLOW}" "${filter}" "${RESET}" >&2
    cut -f1 <<<"${matches}" | sed 's/^/  /' >&2
    exit 1
  fi
  printf '%s\n' "${matches}"
}

# --- commands ----------------------------------------------------------------

cmd_list() {
  local filter="${1:-}" id dir current
  current="$(cat "${PROGRESS_FILE}" 2>/dev/null || true)"
  local last_chapter=''
  while IFS=$'\t' read -r id dir; do
    [[ -z "${filter}" || "${id}" == *"${filter}"* ]] || continue
    local chapter
    chapter="$(basename "$(dirname "${dir}")")"
    if [[ "${chapter}" != "${last_chapter}" ]]; then
      printf '\n%s%s%s\n' "${BOLD}" "${chapter//_/ }" "${RESET}"
      last_chapter="${chapter}"
    fi
    local marker='  '
    [[ "${id}" == "${current}" ]] && marker="${BLUE}->${RESET}"
    printf '  %s %s\n' "${marker}" "${id}"
  done < <(all_exercises)
  printf '\n'
}

cmd_test() {
  local filter="${1:-}"
  if [[ -z "${filter}" ]]; then
    cmd_verify
    return
  fi
  local id dir
  IFS=$'\t' read -r id dir < <(resolve_one "${filter}")
  printf '%s==> %s%s\n%s    %s/exercise.py%s\n' \
    "${BOLD}" "${id}" "${RESET}" "${DIM}" "${dir#"${ROOT}"/}" "${RESET}"
  pytest_ "${dir}/exercise.py" -q
}

cmd_verify() {
  # One pytest session over the whole tree. `--continue-on-collection-errors`
  # matters: some starters deliberately fail at import time (the Python
  # equivalent of "starts as a compile error"), and one of those must not stop
  # the other ninety-nine from being reported.
  pytest_ "${ROOT}/exercises" -q --continue-on-collection-errors
}

# The main loop: run everything once, find the first exercise (in course order)
# that does not pass, and show its failure. That is the one you are working on.
cmd_next() {
  local report
  report="$(mktemp)"
  # -rfE lists FAILED and ERROR lines with their file paths; --tb=no keeps the
  # first pass quiet. Exit status is deliberately ignored here: the parse below
  # decides what to do.
  pytest_ "${ROOT}/exercises" -q --tb=no -rfE --continue-on-collection-errors \
    >"${report}" 2>&1 || true

  local id dir rel
  while IFS=$'\t' read -r id dir; do
    rel="${dir#"${ROOT}"/}/exercise.py"
    if grep -qE "^(FAILED|ERROR) ${rel}" "${report}"; then
      printf '%s==> %s%s\n%s    %s%s\n\n' \
        "${BOLD}" "${id}" "${RESET}" "${DIM}" "${rel}" "${RESET}"
      printf '%s\n' "${id}" >"${PROGRESS_FILE}"
      rm -f "${report}"
      pytest_ "${dir}/exercise.py" -q -x || true
      return 1
    fi
    printf '%s  ok%s %s\n' "${GREEN}" "${RESET}" "${id}"
  done < <(all_exercises)
  rm -f "${report}"

  printf '\n%sEvery exercise passes. That is the whole course.%s\n' \
    "${GREEN}${BOLD}" "${RESET}"
  rm -f "${PROGRESS_FILE}"
}

cmd_solution() {
  local filter="${1:-$(cat "${PROGRESS_FILE}" 2>/dev/null || true)}"
  [[ -n "${filter}" ]] || die "usage: ./npt solution <filter>"
  local id dir solution
  IFS=$'\t' read -r id dir < <(resolve_one "${filter}")
  solution="${ROOT}/solutions/$(basename "$(dirname "${dir}")")/$(basename "${dir}")/exercise.py"
  [[ -f "${solution}" ]] || die "no solution checked in for ${id}"

  printf '%s==> %s: your work vs. the reference solution%s\n\n' \
    "${BOLD}" "${id}" "${RESET}"

  # Strip each file's leading comment block before diffing. The exercise's
  # header is the teaching material and the solution's is one line, so
  # including them would bury the actual difference in forty lines of prose.
  local yours reference
  yours="$(mktemp)"
  reference="$(mktemp)"
  strip_header "${dir}/exercise.py" >"${yours}"
  strip_header "${solution}" >"${reference}"

  diff --unified=3 --label 'yours' --label 'reference' "${yours}" "${reference}" ||
    true
  rm -f "${yours}" "${reference}"
}

# Prints a file from its first non-comment, non-blank line onward.
strip_header() {
  awk '
    started { print; next }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    { started = 1; print }
  ' "$1"
}

cmd_format() {
  if [[ "${1:-}" == "--check" ]]; then
    (cd "${ROOT}" && uv run --quiet ruff format --check exercises solutions)
    printf '%sformatting is clean%s\n' "${GREEN}" "${RESET}"
  else
    (cd "${ROOT}" && uv run --quiet ruff format exercises solutions)
  fi
}

cmd_lint() {
  (cd "${ROOT}" && uv run --quiet ruff check exercises solutions "$@")
}

cmd_clean() {
  find "${ROOT}/exercises" "${ROOT}/solutions" -name '__pycache__' -type d \
    -prune -exec rm -rf {} + 2>/dev/null || true
  rm -rf "${ROOT}/.pytest_cache" "${ROOT}/.ruff_cache"
  rm -f "${PROGRESS_FILE}"
  printf '%sremoved caches%s\n' "${GREEN}" "${RESET}"
}

cmd_solutions_check() {
  # Used by CI to prove every reference solution actually passes.
  pytest_ "${ROOT}/solutions" -q
}

usage() {
  sed -n '3,19p' "${BASH_SOURCE[0]}" | sed 's|^# \{0,1\}||'
}

main() {
  need uv "Install it with: brew install uv  (or see https://docs.astral.sh/uv/)"
  local command="${1:-next}"
  shift || true
  case "${command}" in
    next) cmd_next "$@" ;;
    test | t) cmd_test "$@" ;;
    verify) cmd_verify "$@" ;;
    list | ls) cmd_list "$@" ;;
    solution | sol) cmd_solution "$@" ;;
    format | fmt) cmd_format "$@" ;;
    lint) cmd_lint "$@" ;;
    clean) cmd_clean "$@" ;;
    solutions-check) cmd_solutions_check "$@" ;;
    help | -h | --help) usage ;;
    *) die "unknown command '${command}'. Try ./npt help" ;;
  esac
}

main "$@"
